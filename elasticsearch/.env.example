# Password of the built-in elastic superuser. Used only by the
# elasticsearch-setup service and by operators; never give it to api-pacs.
ELASTIC_PASSWORD=
# Password Kibana uses to connect to Elasticsearch as kibana_system.
KIBANA_SYSTEM_PASSWORD=
# Least-privilege user api-pacs writes and reads audit indices with. Set the
# same values as ELASTICSEARCH_USERNAME / ELASTICSEARCH_PASSWORD in api-pacs/.env.
ELASTICSEARCH_API_PACS_USERNAME=api_pacs
ELASTICSEARCH_API_PACS_PASSWORD=

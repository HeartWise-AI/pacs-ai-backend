APP_TIMEZONE=America/Toronto
# Password for the cardio-agent PostgreSQL service (root docker-compose.yml).
# Generate with `openssl rand -hex 32`; DATABASE_URL in
# cardio-agent/study-service/.env must use the same value.
CARDIO_DB_PASSWORD=
# Image for the study-service API and all of its Celery workers (required in
# production). Written by cardio-agent/study-service/scripts/deploy.sh.
# STUDY_SERVICE_IMAGE=cardio-study-service:git-<sha>

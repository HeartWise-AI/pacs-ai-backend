APP_TIMEZONE=America/Toronto
# Password for the cardio-agent PostgreSQL service (root docker-compose.yml).
# Generate with `openssl rand -hex 32`; DATABASE_URL in
# cardio-agent/study-service/.env must use the same value.
CARDIO_DB_PASSWORD=
# Image for the study-service API and all of its Celery workers (required in
# production). Written by cardio-agent/study-service/scripts/deploy.sh.
# STUDY_SERVICE_IMAGE=cardio-study-service:git-<sha>
# cardio-postgres data stays on a LOCAL named Docker volume; never NFS or a directory shared
# with another host (docs/cardio-postgres.md). Leave unset to keep <project>_cardio_postgres_data.
# CARDIO_POSTGRES_VOLUME=cardio-postgres-data
# Nightly pg_dump -Fc of cardio_agent (cardio-postgres-backup service). Dumps may go to NFS.
# CARDIO_DB_BACKUP_DIR=/mnt/data2/cardio-agent/backups/<host>-cardio-postgres
# CARDIO_DB_BACKUP_AT=02:30
# CARDIO_DB_BACKUP_KEEP_DAYS=14
# TLS for cardio-postgres (off by default). With on, put server.crt and server.key (mode 600,
# owner uid 999) in CARDIO_DB_TLS_DIR, outside git. See docs/cardio-postgres.md.
# CARDIO_DB_SSL=on
# CARDIO_DB_TLS_DIR=./secrets/cardio-postgres-tls

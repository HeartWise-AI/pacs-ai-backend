# Build without a Hugging Face download. Place the checkpoint at the relative path
# configured by models/config.json before building:
#
#   mkdir -p models/11zt0zl5_20250723-162407/models
#   cp /path/to/best_model_epoch_18.pt models/11zt0zl5_20250723-162407/models/
#   docker build --platform linux/amd64 -f Dockerfile.local -t heartwisehub/pacs-ai-deepcoro-mace:local .
#
# The copied checkpoint must match the SHA-256 declared in data/model_info.json, and the
# image is labelled as a local build so it is never mistaken for a published release.
FROM python:3.12.1-slim

ARG PACS_AI_SOURCE_REPOSITORY="HeartWise-AI/pacs-ai-backend"
ARG PACS_AI_SOURCE_REVISION=""
ARG PACS_AI_MODEL_VERSION="1.0.4"
ARG PACS_AI_MODEL_REPOSITORY="heartwise/deepcoro_clip_mace"
ARG PACS_AI_MODEL_REVISION="7be030d1c7b62e41f45a4dd35adff9dae21d884f"
ARG PACS_AI_WEIGHTS_PATH="11zt0zl5_20250723-162407/models/best_model_epoch_18.pt"
ARG PACS_AI_WEIGHTS_SHA256="7edeb4743681afda4ce42254a257c81fb8bbaa7d2886329fbbd6bf298ac8a563"

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor git

RUN pip install uv

WORKDIR /app

# requirements.txt installs the matched PyTorch/torchvision CUDA 12.4 wheels.
COPY requirements.txt .
RUN uv pip install -r requirements.txt --system

COPY download_model.py .
COPY models/ ./models/
RUN python download_model.py \
      --verify-only \
      --repository "${PACS_AI_MODEL_REPOSITORY}" \
      --revision "${PACS_AI_MODEL_REVISION}" \
      --weights-path "${PACS_AI_WEIGHTS_PATH}" \
      --weights-sha256 "${PACS_AI_WEIGHTS_SHA256}"

COPY main.py .
COPY logic.py .
COPY report_input.py .
COPY config.json .
COPY data/ ./data/
COPY docs/ ./docs/
COPY utils/ ./utils/
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

ENV PACS_AI_SOURCE_REVISION="${PACS_AI_SOURCE_REVISION}"
ENV PACS_AI_MODEL_VERSION="${PACS_AI_MODEL_VERSION}"

LABEL org.opencontainers.image.title="DeepCORO-MACE" \
      org.opencontainers.image.version="${PACS_AI_MODEL_VERSION}-local" \
      org.opencontainers.image.revision="${PACS_AI_SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/${PACS_AI_SOURCE_REPOSITORY}" \
      ai.heartwise.model.repository="${PACS_AI_MODEL_REPOSITORY}" \
      ai.heartwise.model.revision="${PACS_AI_MODEL_REVISION}" \
      ai.heartwise.model.weights.path="${PACS_AI_WEIGHTS_PATH}" \
      ai.heartwise.model.weights.sha256="${PACS_AI_WEIGHTS_SHA256}" \
      ai.heartwise.release.channel="local"

EXPOSE 8000

ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

{
  "openapi": "3.0.2",
  "info": {
    "title": "DeepCORO-Integrated inference API",
    "description": "PACS.AI inference API for DeepCORO-CTO, a research-preview per-artery J-CTO scorer for chronic total occlusions on coronary angiography (XA).",
    "termsOfService": "https://github.com/HeartWise-AI",
    "contact": {
      "name": "HeartWise AI",
      "email": "hello@heartwise.ai"
    },
    "version": "2.0.1"
  },
  "servers": [
    {
      "url": "http://deepcoro-cto/api",
      "description": "Docker"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local"
    },
    {
      "url": "http://localhost:8000/api",
      "description": "Local Docker"
    }
  ],
  "tags": [
    {
      "name": "Inference",
      "description": "Inference service"
    }
  ],
  "paths": {
    "/inference/predict": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Predict",
        "description": "Run DeepCORO-CTO inference on up to 10 coronary angiogram DICOM videos. Supported output modes: JSON and HTML.",
        "requestBody": {
          "description": "Prediction request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PredictResponse"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "JSON": {
                    "summary": "Successful JSON J-CTO prediction",
                    "value": {
                      "success": true,
                      "message": "Prediction successful",
                      "data": {
                        "diagnosis": "DeepCORO-CTO [RCA]: J-CTO score = 2 (raw 2.1, difficult) | Calcification at occlusion, Bending > 45°",
                        "predictions": {
                          "jctoScore": {
                            "predicted": 2.1,
                            "predictedInteger": 2,
                            "componentsAboveThreshold": 2,
                            "difficulty": "difficult"
                          },
                          "components": {
                            "jcto_blunt_stump": {
                              "name": "Blunt / flush stump",
                              "probability": 0.32,
                              "threshold": 0.5,
                              "present": false
                            },
                            "jcto_calcification": {
                              "name": "Calcification at occlusion",
                              "probability": 0.71,
                              "threshold": 0.5,
                              "present": true
                            },
                            "jcto_bending_gt45": {
                              "name": "Bending > 45°",
                              "probability": 0.64,
                              "threshold": 0.5,
                              "present": true
                            },
                            "jcto_occlusion_length_gt20": {
                              "name": "Occlusion length ≥ 20 mm",
                              "probability": 0.41,
                              "threshold": 0.5,
                              "present": false
                            }
                          },
                          "ctoArtery": "RCA",
                          "perArtery": {
                            "LAD": {
                              "jctoScore": 0.31,
                              "jctoScoreInteger": 0,
                              "components": {
                                "jcto_blunt_stump": 0.08,
                                "jcto_calcification": 0.11,
                                "jcto_bending_gt45": 0.05,
                                "jcto_occlusion_length_gt20": 0.09
                              }
                            },
                            "RCA": {
                              "jctoScore": 2.1,
                              "jctoScoreInteger": 2,
                              "components": {
                                "jcto_blunt_stump": 0.32,
                                "jcto_calcification": 0.71,
                                "jcto_bending_gt45": 0.64,
                                "jcto_occlusion_length_gt20": 0.41
                              }
                            },
                            "LCx": {
                              "jctoScore": 0.12,
                              "jctoScoreInteger": 0,
                              "components": {
                                "jcto_blunt_stump": 0.04,
                                "jcto_calcification": 0.06,
                                "jcto_bending_gt45": 0.03,
                                "jcto_occlusion_length_gt20": 0.05
                              }
                            }
                          }
                        },
                        "modelRecommendations": {
                          "en": "<strong>Predicted imaging J-CTO score 2 in the RCA (raw 2.1, difficult).</strong> This is the four morphological imaging components only (range 0–4); it does not include the classic fifth point for a previously failed attempt.",
                          "fr": "<strong>Score J-CTO morphologique prédit 2 pour l’artère coronaire droite (brut 2.1, difficult).</strong> Il s'agit des quatre composantes morphologiques d'imagerie seulement (plage 0–4).",
                          "presentable": true
                        }
                      }
                    }
                  },
                  "HTML": {
                    "summary": "Successful HTML J-CTO report",
                    "value": {
                      "success": true,
                      "message": "Prediction successful",
                      "data": {
                        "htmlBase64": "PCFET0NUWVBFIGh0bWw+PGh0bWw+PGhlYWQ+PG1ldGEgY2hhcnNldD0idXRmLTgiPjx0aXRsZT5EZWVwQ09STy1DVE8gUmVwb3J0PC90aXRsZT48L2hlYWQ+PGJvZHk+PGgxPkRlZXBDT1JPLUNUTyBKLUNUTyBBc3Nlc3NtZW50PC9oMT48cD5QcmVkaWN0ZWQgSi1DVE8gc2NvcmU6IDIuMSAoZGlmZmljdWx0KTwvcD48L2JvZHk+PC9odG1sPg=="
                      }
                    }
                  }
                }
              }
            }
          },
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model-info": {
      "get": {
        "tags": [
          "Inference"
        ],
        "summary": "Get Model Info",
        "description": "Get DeepCORO-CTO model info",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetModelInfoResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "message": "Model info retrieved successfully",
                  "data": {
                    "modelId": "DeepCORO_Integrated",
                    "modelName": "DeepCORO-Integrated",
                    "domainName": "Cardiology",
                    "stage": "ai_inference",
                    "modality": "Angiogram",
                    "version": "1.0.0",
                    "provenance": {
                      "sourceRepository": "HeartWise-AI/pacs-ai-backend",
                      "sourceRevision": null,
                      "modelRepository": "heartwise/DeepCORO_Integrated",
                      "modelRevision": "927beafadf21205292733897c2ffdfc54606c7fb",
                      "weightsPath": "model.safetensors",
                      "weightsSha256": "cc9d84a3fe6849579a74061edd744f169121814db40c0b8bfa676fb49c1a7325"
                    },
                    "resources": {
                      "gpuRequired": true,
                      "residentMemoryMiB": 1700,
                      "peakMemoryMiB": 11000,
                      "maxConcurrentInferences": 1,
                      "idleTimeoutSeconds": 600
                    },
                    "dicomTargetLevel": "SERIES",
                    "dicomUploadMin": 1,
                    "dicomUploadMax": 12,
                    "supportedDicomModalities": [
                      "XA"
                    ],
                    "supportedDicomTags": [
                      "*"
                    ],
                    "supportedAdditionalMetadata": [],
                    "supportedOutputModes": [
                      "HTML",
                      "JSON"
                    ],
                    "approveFeedbackQuestionnaires": [
                      {
                        "id": "confidence",
                        "type": "RADIO",
                        "questionEn": "How confident are you in the model's J-CTO assessment?",
                        "questionFr": "À quel point êtes-vous confiant dans l'évaluation J-CTO du modèle ?",
                        "answerOptionsEn": [
                          {
                            "id": "very",
                            "answer": "Very confident"
                          },
                          {
                            "id": "somewhat",
                            "answer": "Somewhat confident"
                          },
                          {
                            "id": "neutral",
                            "answer": "Neutral"
                          }
                        ],
                        "answerOptionsFr": [
                          {
                            "id": "very",
                            "answer": "Très confiant"
                          },
                          {
                            "id": "somewhat",
                            "answer": "Assez confiant"
                          },
                          {
                            "id": "neutral",
                            "answer": "Neutre"
                          }
                        ]
                      },
                      {
                        "id": "comments",
                        "type": "TEXT",
                        "questionEn": "Any additional comments?",
                        "questionFr": "Des commentaires supplémentaires ?",
                        "answerOptionsEn": null,
                        "answerOptionsFr": null
                      }
                    ],
                    "rejectFeedbackQuestionnaires": [
                      {
                        "id": "reason",
                        "type": "CHECKBOX",
                        "questionEn": "Why do you disagree with the prediction?",
                        "questionFr": "Pourquoi n'êtes-vous pas d'accord ?",
                        "answerOptionsEn": [
                          {
                            "id": "score",
                            "answer": "J-CTO score incorrect"
                          },
                          {
                            "id": "component",
                            "answer": "One or more J-CTO components incorrect"
                          },
                          {
                            "id": "quality",
                            "answer": "Poor image quality"
                          },
                          {
                            "id": "clinical",
                            "answer": "Doesn't match clinical findings"
                          },
                          {
                            "id": "other",
                            "answer": "Other"
                          }
                        ],
                        "answerOptionsFr": [
                          {
                            "id": "score",
                            "answer": "Score J-CTO incorrect"
                          },
                          {
                            "id": "component",
                            "answer": "Une ou plusieurs composantes J-CTO incorrectes"
                          },
                          {
                            "id": "quality",
                            "answer": "Mauvaise qualité d'image"
                          },
                          {
                            "id": "clinical",
                            "answer": "Ne correspond pas aux résultats cliniques"
                          },
                          {
                            "id": "other",
                            "answer": "Autre"
                          }
                        ]
                      },
                      {
                        "id": "details",
                        "type": "TEXT",
                        "questionEn": "Please describe what was incorrect:",
                        "questionFr": "Veuillez décrire ce qui était incorrect :",
                        "answerOptionsEn": null,
                        "answerOptionsFr": null
                      }
                    ]
                  }
                }
              }
            }
          },
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model-facts": {
      "get": {
        "tags": [
          "Inference"
        ],
        "summary": "Get Model Facts",
        "description": "Get DeepCORO-CTO model facts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetModelFactsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "message": "Model facts retrieved successfully",
                  "data": {
                    "en": {
                      "Summary": {
                        "Name": "DeepCORO-Integrated",
                        "Description": "One EchoJEPA video encoder (ViT-L) that segments the coronary tree into 26 SYNTAX classes itself and, from up to 12 diagnostic coronary angiography runs per study, predicts the % diameter stenosis and the probability of a significant lesion in each of 18 coronary segments, plus LAD-territory FFR and iFR (value and probability of an abnormal result). The encoder runs at most twice per study: full views at 224 px, then up to 4 tracked 320 px crops per segment. Version 1.0.0 serves model v12.",
                        "Developed_by": "HeartWise.AI / MHI",
                        "Development_period": "2025-2026",
                        "Version": "1.0.0"
                      },
                      "Mechanism": {
                        "Outcome": "Per-segment coronary stenosis (18 segments) and LAD FFR/iFR",
                        "Output": "segments.<segment>.stenosis_pct (0-100), segments.<segment>.prob_significant (>= 70%, left main >= 50%); lad_physiology.ffr, .ifr, .ffr_abnormal_prob (FFR <= 0.80), .ifr_abnormal_prob (iFR <= 0.89); n_videos, encoder_passes",
                        "Target_population": "Adults undergoing diagnostic coronary angiography at MHI",
                        "Input_data_source": "Diagnostic left and right coronary contrast runs (multi-frame XA DICOM)",
                        "Input_data_type": "dicom",
                        "Model_type": "Deep learning: EchoJEPA ViT-L video encoder with its own segmentation decoder, tracked segment crops and per-segment attention pooling; LAD physiology head on the left main / LAD / diagonal features",
                        "Supported_DICOM_modalities": "XA"
                      },
                      "Model_Components": {
                        "Model": {
                          "Purpose": "Read stenosis severity in every coronary segment and estimate LAD physiology from the angiogram alone",
                          "Output": "18 stenosis percentages and probabilities, LAD FFR/iFR values and abnormal probabilities"
                        }
                      },
                      "Uses_and_directions": {
                        "General_use": "Research preview of segment-level stenosis reading and image-only LAD physiology estimation.",
                        "Target_population_and_use_case": "Adults with diagnostic coronary angiography. Upload the diagnostic left and right coronary contrast runs (no PCI, stent or ventriculography runs); up to 12 are used, chosen by SeriesTime.",
                        "Before_using_this_model": "Held-out test (3,194 studies / 2,941 patients): stenosis macro AUROC 0.884 (DeepCORO-CLIP 0.850, EchoJEPA 0.851); mean per-segment Pearson r 0.50, 9 of 18 segments above 0.5. LAD FFR/iFR pooled AUROC 0.72 (95% CI 0.66-0.79; 274 measurements), FFR alone 0.69, iFR alone 0.73. Confirm every reading on the images."
                      },
                      "Warnings_and_limitations": {
                        "Input_selection": "The model was trained only on diagnostic left/right coronary contrast runs without stents. This version does not filter uploads; PCI, stent, ventriculography or non-contrast runs will degrade the output.",
                        "Distal_and_branch_segments": "Agreement with the cath report is weaker for distal LAD, distal LCx, diagonals, marginals, ramus and posterior LV branches (r 0.27-0.47).",
                        "Physiology": "LAD FFR/iFR outputs reach AUROC 0.72 on test and do not replace invasive measurement; FFR alone was tested on only 76 measurements (CI 0.55-0.81).",
                        "Video_encoding": "DICOMs are converted exactly as the training videos (MJPG AVI). About 13% of training/test videos had been stored as MP4; for those studies the DICOM path differs slightly from the AVI-based test results.",
                        "Confidence_Scores": "Probabilities are not calibrated to a clinical operating point; no decision threshold has been validated."
                      }
                    }
                  }
                }
              }
            }
          },
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model/runtime": {
      "get": {
        "tags": [
          "Model lifecycle"
        ],
        "summary": "Get model runtime",
        "description": "Return the current model residency and activity state without loading the model.",
        "responses": {
          "200": {
            "description": "Current runtime state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ModelRuntime"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/inference/model/load": {
      "post": {
        "tags": [
          "Model lifecycle"
        ],
        "summary": "Load model",
        "description": "Load model weights into memory. Repeated calls are idempotent.",
        "responses": {
          "200": {
            "description": "Model is ready",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ModelRuntime"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Model failed to load",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model/unload": {
      "post": {
        "tags": [
          "Model lifecycle"
        ],
        "summary": "Unload model",
        "description": "Wait for active inference to finish, release model resources, and restart the supervised API process when needed.",
        "responses": {
          "200": {
            "description": "Model is unloaded",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ModelRuntime"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PredictRequest": {
        "required": [
          "outputMode"
        ],
        "type": "object",
        "properties": {
          "seriesInstanceImages": {
            "type": "object",
            "description": "Map of series number -> instance number -> base64-encoded XA DICOM. Up to 8 videos are used after SeriesTime sorting.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "seriesInstanceMetadata": {
            "type": "object",
            "nullable": true
          },
          "additionalMetadata": {
            "type": "object",
            "nullable": true,
            "description": "Unused for DeepCORO-CTO (view class is inferred from DICOM angles)."
          },
          "outputMode": {
            "type": "string",
            "enum": [
              "HTML",
              "JSON"
            ],
            "description": "Output mode supported by DeepCORO-CTO"
          }
        }
      },
      "APIResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation successful"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "APIErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Bad Request"
          },
          "errorCode": {
            "type": "string",
            "example": "BAD_REQUEST"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "GetModelInfoResponse": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "Model identifier",
            "example": "DeepCORO_CTO"
          },
          "modelName": {
            "type": "string",
            "description": "Model display name",
            "example": "DeepCORO-CTO"
          },
          "version": {
            "type": "string",
            "description": "Model version",
            "example": "1.0.0"
          },
          "dicomTargetLevel": {
            "type": "string",
            "enum": [
              "PATIENT",
              "STUDY",
              "SERIES",
              "INSTANCE"
            ],
            "description": "DICOM target level",
            "example": "SERIES"
          },
          "dicomUploadMin": {
            "type": "integer",
            "description": "Minimum number of DICOM videos to upload for inference",
            "example": 1
          },
          "dicomUploadMax": {
            "type": "integer",
            "description": "Maximum number of DICOM videos used per study",
            "example": 8
          },
          "supportedDicomModalities": {
            "type": "array",
            "description": "Supported DICOM modalities",
            "items": {
              "type": "string",
              "example": "XA"
            }
          },
          "supportedDicomTags": {
            "type": "array",
            "description": "Supported DICOM tags",
            "items": {
              "type": "string",
              "example": "*"
            }
          },
          "supportedAdditionalMetadata": {
            "type": "array",
            "description": "No Step-2 variables; view class is inferred from positioner angles",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "supportedOutputModes": {
            "type": "array",
            "description": "Supported output modes",
            "items": {
              "type": "string",
              "enum": [
                "JSON",
                "HTML"
              ],
              "example": "JSON"
            }
          }
        }
      },
      "GetModelFactsResponse": {
        "type": "object",
        "properties": {
          "en": {
            "type": "object",
            "description": "Model facts in English. See example for DeepCORO-CTO / J-CTO details."
          }
        }
      },
      "PredictResponse": {
        "type": "object",
        "description": "JSON mode returns diagnosis/predictions/modelRecommendations; HTML mode returns htmlBase64.",
        "properties": {
          "diagnosis": {
            "type": "string",
            "description": "Short J-CTO assessment summary (JSON mode)"
          },
          "predictions": {
            "type": "object",
            "description": "jctoScore (predicted, predictedInteger, componentsAboveThreshold, difficulty) plus per-component probabilities for the selected artery; per-artery checkpoints also return ctoArtery (LAD/RCA/LCx) and perArtery raw outputs (JSON mode); an LCx call also returns ctoArteryWarning (EN/FR) because LCx grading is unreliable"
          },
          "modelRecommendations": {
            "type": "object",
            "description": "Operator-facing EN/FR recommendations (JSON mode)"
          },
          "htmlBase64": {
            "type": "string",
            "description": "Base64-encoded HTML report (HTML mode)"
          }
        }
      },
      "ModelRuntime": {
        "type": "object",
        "required": [
          "state",
          "loaded",
          "activeRequests",
          "lastUsedAt"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "UNLOADED",
              "LOADING",
              "READY",
              "BUSY",
              "EVICTING",
              "ERROR"
            ]
          },
          "loaded": {
            "type": "boolean"
          },
          "activeRequests": {
            "type": "integer",
            "minimum": 0
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
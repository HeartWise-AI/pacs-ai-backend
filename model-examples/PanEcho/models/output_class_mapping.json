{
    "pericardial-effusion": {
        "mild_mod_severe": 0,
        "none_trace": 1,
        "description": "Pericardial effusion"
    },
    "EF": {
        "regression": 0,
        "units": "%",
        "description": "Left ventricular (LV) ejection fraction",
        "normal_range": {"min": 52, "max": 72},
        "thresholds": {
            "mildly_abnormal": {"min": 41, "max": 51},
            "moderately_abnormal": {"min": 30, "max": 40},
            "severely_abnormal": {"max": 29}
        }
    },
    "GLS": {
        "regression": 0,
        "units": "%",
        "description": "Global longitudinal strain",
        "note": "Absolute value; actual is negative",
        "normal_range": {"min": 18},
        "thresholds": {
            "borderline": {"min": 16, "max": 17.9},
            "mildly_abnormal": {"min": 14, "max": 15.9},
            "moderately_abnormal": {"min": 10, "max": 13.9},
            "severely_abnormal": {"max": 9.9}
        }
    },
    "LVEDV": {
        "regression": 0,
        "units": "mL",
        "description": "LV end-diastolic volume",
        "normal_range": {"max": 150},
        "note": "Should be indexed to BSA; >74 mL/m² abnormal"
    },
    "LVESV": {
        "regression": 0,
        "units": "mL",
        "description": "LV end-systolic volume",
        "normal_range": {"max": 61},
        "note": "Should be indexed to BSA; >31 mL/m² abnormal"
    },
    "LVSV": {
        "regression": 0,
        "units": "mL",
        "description": "LV stroke volume",
        "normal_range": {"min": 50, "max": 100}

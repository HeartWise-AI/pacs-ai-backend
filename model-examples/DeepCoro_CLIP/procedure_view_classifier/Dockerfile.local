FROM heartwisehub/pacs-ai-procedure_view-classifier@sha256:5850d9e20dd9e4d9799c69a866bf8e92647c5cd2d37d9ab83c15f922067c8b39

ARG PACS_AI_SOURCE_REVISION
ENV PACS_AI_SOURCE_REVISION=${PACS_AI_SOURCE_REVISION}
LABEL org.opencontainers.image.source="https://github.com/HeartWise-AI/pacs-ai-backend" \
      org.opencontainers.image.revision=${PACS_AI_SOURCE_REVISION} \
      ai.heartwise.release.channel="local" \
      ai.heartwise.base.digest="sha256:5850d9e20dd9e4d9799c69a866bf8e92647c5cd2d37d9ab83c15f922067c8b39"

# Preserve and verify the trained assets and cached architecture in the base.
RUN python -c 'import hashlib,pathlib,re,os; assert re.fullmatch("[0-9a-f]{40}",os.environ["PACS_AI_SOURCE_REVISION"]); expected={"vaso_vision.pt":"8c16997b8848a3a670168403e96f2d286b472aa8addad8e3012df48d4f14c65b","class_mapping.json":"840654f724b91ac1a6168e4b7a9da83053f2bbaabbde4fd0a62c06dd80cb4767","config.json":"9e7567eb51e5fc8669778f10a019f7c04ff42d36ec273e906e9fb14c61b782bd"}; assert all(hashlib.sha256((pathlib.Path("/app/models")/name).read_bytes()).hexdigest()==digest for name,digest in expected.items())'

COPY main.py logic.py /app/
COPY utils/ /app/utils/
COPY data/ /app/data/
COPY docs/ /app/docs/
COPY models/vaso_vision.py /app/models/vaso_vision.py
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

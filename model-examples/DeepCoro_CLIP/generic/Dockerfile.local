# Build without a Hugging Face download. Place the checkpoint in ./models/:
#
#   mkdir -p models/zcb8cu0l_20260213-033432
#   cp /path/to/best_model_epoch_11.pt models/zcb8cu0l_20260213-033432/
#   docker build --platform linux/amd64 -f Dockerfile.local -t deepcoro-clip-generic:local .
FROM python:3.12.1-slim

ARG PACS_AI_SOURCE_REPOSITORY="HeartWise-AI/pacs-ai-backend"
ARG PACS_AI_SOURCE_REVISION=""
ARG PACS_AI_MODEL_VERSION="1.0.1"
ARG PACS_AI_MODEL_REPOSITORY="heartwise/DeepCoro_CLIP_generic"
ARG PACS_AI_MODEL_REVISION="bb3f5e4785eed5f493d20a5406feed40cace84cf"
ARG PACS_AI_WEIGHTS_PATH="zcb8cu0l_20260213-033432/best_model_epoch_11.pt"
ARG PACS_AI_WEIGHTS_SHA256="4eac7676bc24930466d84f04f813fcbc1b9e70b056232cad603f18c84d008267"

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor git

RUN pip install uv

WORKDIR /app

COPY requirements.txt .
RUN uv pip install -r requirements.txt --system

COPY download_model.py .
COPY models/ ./models/
RUN python download_model.py \
      --verify-only \
      --repository "${PACS_AI_MODEL_REPOSITORY}" \
      --revision "${PACS_AI_MODEL_REVISION}" \
      --weights-path "${PACS_AI_WEIGHTS_PATH}" \
      --weights-sha256 "${PACS_AI_WEIGHTS_SHA256}"

COPY main.py .
COPY logic.py .
COPY config.json .
COPY data/ ./data/
COPY docs/ ./docs/
COPY utils/ ./utils/
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

ENV PACS_AI_SOURCE_REVISION="${PACS_AI_SOURCE_REVISION}"
ENV PACS_AI_MODEL_VERSION="${PACS_AI_MODEL_VERSION}"

LABEL org.opencontainers.image.title="DeepCoro-CLIP generic" \
      org.opencontainers.image.version="${PACS_AI_MODEL_VERSION}-local" \
      org.opencontainers.image.revision="${PACS_AI_SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/${PACS_AI_SOURCE_REPOSITORY}" \
      ai.heartwise.model.repository="${PACS_AI_MODEL_REPOSITORY}" \
      ai.heartwise.model.revision="${PACS_AI_MODEL_REVISION}" \
      ai.heartwise.model.weights.path="${PACS_AI_WEIGHTS_PATH}" \
      ai.heartwise.model.weights.sha256="${PACS_AI_WEIGHTS_SHA256}" \
      ai.heartwise.release.channel="local"

EXPOSE 8000

ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

{
  "openapi": "3.0.2",
  "info": {
    "title": "DeepCORO-SYNTAX Inference API",
    "description": "Research inference of modified 16-segment SYNTAX scores from up to 10 coronary angiography videos. Not for clinical use.",
    "termsOfService": "https://github.com/HeartWise-AI",
    "contact": {
      "name": "HeartWise AI",
      "email": "hello@heartwise.ai"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Container reverse proxy"
    },
    {
      "url": "http://localhost:8000",
      "description": "Direct local API"
    }
  ],
  "tags": [
    {
      "name": "Inference",
      "description": "Inference service"
    }
  ],
  "paths": {
    "/inference/predict": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Predict",
        "description": "Creates a prediction request",
        "requestBody": {
          "description": "Prediction request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PredictResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/inference/model-info": {
      "get": {
        "tags": [
          "Inference"
        ],
        "summary": "Get Model Info",
        "description": "Get model info",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetModelInfoResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "message": "Model info retrieved successfully",
                  "data": {
                    "modelId": "DeepCORO_SYNTAX",
                    "modelName": "DeepCORO-SYNTAX",
                    "domainName": "Cardiology",
                    "stage": "ai_inference",
                    "modality": "Angiogram",
                    "version": "6.0.0",
                    "provenance": {
                      "sourceRepository": "HeartWise-AI/pacs-ai-backend",
                      "sourceRevision": null,
                      "modelRepository": "heartwise/deepcoro_clip_cardiosyntax",
                      "modelRevision": "1ffb38cfc10fa10c4b60f44746063feb860eeba0",
                      "weightsPath": "v6_20260929-203527/models/best_model_epoch_19.pt",
                      "weightsSha256": "856f5d6523c25a45c62886bf6cd1d351297821f60c3465a20b962aa46fa08ec0"
                    },
                    "resources": {
                      "gpuRequired": true,
                      "residentMemoryMiB": 5746,
                      "peakMemoryMiB": 6490,
                      "maxConcurrentInferences": 1,
                      "idleTimeoutSeconds": 600
                    },
                    "dicomTargetLevel": "STUDY",
                    "dicomUploadMin": 1,
                    "dicomUploadMax": 10,
                    "supportedDicomModalities": [
                      "XA"
                    ],
                    "supportedDicomTags": [
                      "*"
                    ],
                    "supportedAdditionalMetadata": [],
                    "supportedOutputModes": [
                      "HTML",
                      "JSON"
                    ],
                    "approveFeedbackQuestionnaires": [
                      {
                        "id": "confidence",
                        "type": "RADIO",
                        "questionEn": "How confident are you in the model's SYNTAX estimate?",
                        "questionFr": "Quelle confiance accordez-vous à l'estimation SYNTAX du modèle ?",
                        "answerOptionsEn": [
                          {
                            "id": "very",
                            "answer": "Very confident"
                          },
                          {
                            "id": "somewhat",
                            "answer": "Somewhat confident"
                          },
                          {
                            "id": "neutral",
                            "answer": "Neutral"
                          },
                          {
                            "id": "not",
                            "answer": "Not confident"
                          }
                        ],
                        "answerOptionsFr": [
                          {
                            "id": "very",
                            "answer": "Très confiant"
                          },
                          {
                            "id": "somewhat",
                            "answer": "Assez confiant"
                          },
                          {
                            "id": "neutral",
                            "answer": "Neutre"
                          },
                          {
                            "id": "not",
                            "answer": "Peu confiant"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model-facts": {
      "get": {
        "tags": [
          "Inference"
        ],
        "summary": "Get Model Facts",
        "description": "Get model facts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetModelFactsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "message": "Model facts retrieved successfully",
                  "data": {
                    "en": {
                      "Summary": {
                        "Name": "DeepCORO-SYNTAX",
                        "Description": "DeepCORO-CLIP based estimator of a modified SYNTAX score from a complete multi-view coronary angiography study. Emits continuous global, left and right scores plus four-class severity.",
                        "Developed_by": "HeartWise.AI / Montreal Heart Institute",
                        "Development_period": "2025-2026",
                        "Version": "6.0.0 (CardioSYNTAX v3, 16-segment reference standard)"
                      },
                      "Mechanism": {
                        "Outcome": "Modified SYNTAX score (continuous) and four-class severity",
                        "Output": "syntax: points; syntax_left / syntax_right: territory points; syntax_category: zero / 1-22 / 23-32 / >=33",
                        "Target_population": "Adults undergoing diagnostic coronary angiography. Not validated in grafted anatomy; prior-CABG studies were excluded from development.",
                        "Input_data_source": "Diagnostic coronary angiogram, up to 10 projections per study",
                        "Input_data_type": "dicom",
                        "Model_type": "Deep Learning (MViT encoder + multiple-instance linear probing)",
                        "Supported_DICOM_modalities": "XA"
                      },
                      "Model_Components": {
                        "Model": {
                          "Purpose": "Estimate modified SYNTAX score and severity band from a whole angiographic study",
                          "Output": "Continuous score, territory scores, severity class"
                        }
                      },
                      "Uses_and_directions": {
                        "Intended_use": "Triage and consistency aid. A clinician confirms the output against the images. It is a rule-out aid for intermediate-to-high complexity (>=23), not a confirmatory test.",
                        "Not_intended_use": "Autonomous scoring, treatment decisions without Heart Team review, grafted anatomy, or any use where a fully specified SYNTAX score is required.",
                        "Directions": "Submit a complete diagnostic study. Read the severity band alongside the continuous score; the two can disagree near a cut-point."
                      },
                      "Warnings": {
                        "Reference_standard": "The reference is a MODIFIED SYNTAX score (16-segment, segment-based), not a core-laboratory SYNTAX score. It covers 16 of 25 segments, never records severe tortuosity, and captures none of the five total-occlusion sub-modifiers. All omissions are one-directional: the score is biased downward, most in occlusive and multivessel disease.",
                        "Validation_status": "No fully external validation. Both development cohorts contributed training data; the second-institution result is held-out internal performance. Manuscript under peer review (EuroIntervention EIJ-D-26-00383).",
                        "Known_bias": "Proportional underestimation persists in complex anatomy. Across both held-out cohorts, v6 MAE was 7.4 points with -4.6-point bias for reference scores 23-32 and 10.9 points with -10.2-point bias for reference scores >=33.",
                        "Explainability": "No segment-level attribution. Attention weights indicate which projections were used, not which anatomic structures.",
                        "Performance": "Held-out v6 comparison: CardioSYNTAX n=369: MAE 3.21 (2.77-3.64), bias -0.35 (-0.87-0.17), rho 0.76 (0.71-0.81), ICC 0.86 (0.82-0.89), AUROC >=23 0.97 (0.95-0.99). MHI n=127: MAE 4.47 (3.67-5.30), bias -0.57 (-1.68-0.58), rho 0.81 (0.71-0.88), ICC 0.79 (0.71-0.86), AUROC >=23 0.89 (0.79-0.97). Single training seed; prospective and external validation remain outstanding."
                      }
                    }
                  }
                }
              }
            }
          },
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model/runtime": {
      "get": {
        "tags": [
          "Model lifecycle"
        ],
        "summary": "Get model runtime",
        "description": "Return the current model residency and activity state without loading the model.",
        "responses": {
          "200": {
            "description": "Current runtime state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ModelRuntime"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/inference/model/load": {
      "post": {
        "tags": [
          "Model lifecycle"
        ],
        "summary": "Load model",
        "description": "Load model weights into memory. Repeated calls are idempotent.",
        "responses": {
          "200": {
            "description": "Model is ready",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ModelRuntime"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Model failed to load",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/inference/model/unload": {
      "post": {
        "tags": [
          "Model lifecycle"
        ],
        "summary": "Unload model",
        "description": "Wait for active inference to finish, release model resources, and restart the supervised API process when needed.",
        "responses": {
          "200": {
            "description": "Model is unloaded",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ModelRuntime"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PredictRequest": {
        "required": [
          "outputMode"
        ],
        "type": "object",
        "properties": {
          "seriesInstanceMetadata": {
            "type": "object"
          },
          "additionalMetadata": {
            "type": "object",
            "nullable": true
          },
          "outputMode": {
            "type": "string",
            "enum": [
              "HTML",
              "JSON"
            ],
            "description": "Output mode"
          },
          "seriesInstanceImages": {
            "type": "object",
            "nullable": true,
            "description": "Series and instance indices mapped to base64-encoded DICOM files.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "APIResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation successful"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "APIErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Bad Request"
          },
          "errorCode": {
            "type": "string",
            "example": "BAD_REQUEST"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "GetModelInfoResponse": {
        "type": "object",
        "properties": {
          "modelName": {
            "type": "string",
            "description": "Model display name",
            "example": "DeepCORO-SYNTAX"
          },
          "version": {
            "type": "string",
            "description": "Model version",
            "example": "6.0.0"
          },
          "provenance": {
            "type": "object",
            "description": "Immutable source and model artifact identifiers.",
            "properties": {
              "sourceRepository": {"type": "string"},
              "sourceRevision": {"type": "string", "nullable": true},
              "modelRepository": {"type": "string"},
              "modelRevision": {"type": "string"},
              "weightsPath": {"type": "string"},
              "weightsSha256": {"type": "string"}
            }
          },
          "resources": {
            "type": "object",
            "description": "Model Manager resource and concurrency contract."
          },
          "dicomTargetLevel": {
            "type": "string",
            "enum": [
              "PATIENT",
              "STUDY",
              "SERIES",
              "INSTANCE"
            ],
            "description": "DICOM target level",
            "example": "STUDY"
          },
          "dicomUploadMin": {
            "type": "integer",
            "description": "Minimum number of DICOM instances to upload for inference",
            "example": 1
          },
          "dicomUploadMax": {
            "type": "integer",
            "description": "Maximum number of DICOM instances to upload for inference",
            "example": 10
          },
          "supportedDicomModalities": {
            "type": "array",
            "description": "Supported DICOM modalities",
            "items": {
              "type": "string",
              "example": "XA"
            },
            "example": [
              "XA"
            ]
          },
          "supportedDicomTags": {
            "type": "array",
            "description": "Supported DICOM tags",
            "items": {
              "type": "string",
              "example": "00200011"
            },
            "example": [
              "*"
            ]
          },
          "supportedAdditionalMetadata": {
            "type": "array",
            "description": "Supported additional metadata",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "smoking"
                },
                "name": {
                  "type": "string",
                  "example": "Smoking"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "boolean",
                    "number",
                    "string"
                  ],
                  "example": "boolean"
                },
                "required": {
                  "type": "boolean",
                  "example": true
                }
              }
            },
            "example": []
          },
          "supportedOutputModes": {
            "type": "array",
            "description": "Supported output modes",
            "items": {
              "type": "string",
              "enum": [
                "HTML",
                "JSON"
              ],
              "example": "JSON"
            },
            "example": [
              "HTML",
              "JSON"
            ]
          }
        }
      },
      "GetModelFactsResponse": {
        "type": "object",
        "properties": {
          "en": {
            "type": "object",
            "description": "Model facts in English. See example for more details."
          }
        }
      },
      "PredictResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "htmlBase64"
            ],
            "properties": {
              "htmlBase64": {
                "type": "string",
                "description": "Base64-encoded DeepCORO-SYNTAX HTML report."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "predictions",
              "modelRecommendations"
            ],
            "properties": {
              "predictions": {
                "type": "object",
                "description": "Global and territory SYNTAX scores, category probabilities and threshold interpretation."
              },
              "diagnosis": {
                "type": "string",
                "nullable": true
              },
              "modelRecommendations": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "en": {
                    "type": "string",
                    "nullable": true
                  },
                  "fr": {
                    "type": "string",
                    "nullable": true
                  },
                  "presentable": {
                    "type": "boolean",
                    "nullable": true
                  }
                }
              }
            }
          }
        ]
      },
      "ModelRuntime": {
        "type": "object",
        "required": [
          "state",
          "loaded",
          "activeRequests",
          "lastUsedAt"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "UNLOADED",
              "LOADING",
              "READY",
              "BUSY",
              "EVICTING",
              "ERROR"
            ]
          },
          "loaded": {
            "type": "boolean"
          },
          "activeRequests": {
            "type": "integer",
            "minimum": 0
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}

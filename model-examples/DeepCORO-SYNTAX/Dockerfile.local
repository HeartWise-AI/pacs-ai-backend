# Build without HuggingFace download — expects the .pt checkpoint to already
# sit in ./models/ on the build host. Use this when you have the weights
# locally (e.g. /media/data1/models/CathEF_CLIP/best_model_epoch_43.pt).
#
#   cp /media/data1/models/CathEF_CLIP/best_model_epoch_43.pt models/
#   docker build -f Dockerfile.local -t heartwisehub/cathef-clip:1.0 .
FROM python:3.12.1-slim

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor git

RUN pip install uv

WORKDIR /app

COPY requirements.txt .
RUN uv pip install -r requirements.txt --system

COPY main.py .
COPY logic.py .
COPY config.json .
COPY data/ ./data/
COPY docs/ ./docs/
COPY models/ ./models/
COPY utils/ ./utils/
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

EXPOSE 8000

ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

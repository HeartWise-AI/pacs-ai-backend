# Build without HuggingFace download. Place the checkpoint at the relative path
# configured by models/config.json before building:
#
#   mkdir -p models/v6_20260929-203527/models
#   cp /path/to/best_model_epoch_19.pt models/v6_20260929-203527/models/
#   docker build --platform linux/amd64 -f Dockerfile.local -t pacs-ai-deepcoro-syntax:local .
FROM python:3.12.1-slim

ARG PACS_AI_SOURCE_REPOSITORY="HeartWise-AI/pacs-ai-backend"
ARG PACS_AI_SOURCE_REVISION=""
ARG PACS_AI_MODEL_VERSION="6.0.0"
ARG PACS_AI_MODEL_REPOSITORY="heartwise/deepcoro_clip_cardiosyntax"
ARG PACS_AI_MODEL_REVISION="1ffb38cfc10fa10c4b60f44746063feb860eeba0"
ARG PACS_AI_WEIGHTS_PATH="v6_20260929-203527/models/best_model_epoch_19.pt"
ARG PACS_AI_WEIGHTS_SHA256="856f5d6523c25a45c62886bf6cd1d351297821f60c3465a20b962aa46fa08ec0"

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor git

RUN pip install uv

WORKDIR /app

# requirements.txt installs the matched PyTorch/torchvision CUDA 12.4 wheels.
COPY requirements.txt .
RUN uv pip install -r requirements.txt --system

COPY download_model.py .
COPY models/ ./models/
RUN python download_model.py \
      --verify-only \
      --repository "${PACS_AI_MODEL_REPOSITORY}" \
      --revision "${PACS_AI_MODEL_REVISION}" \
      --weights-path "${PACS_AI_WEIGHTS_PATH}" \
      --weights-sha256 "${PACS_AI_WEIGHTS_SHA256}"

COPY main.py .
COPY logic.py .
COPY config.json .
COPY data/ ./data/
COPY docs/ ./docs/
COPY utils/ ./utils/
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

ENV PACS_AI_SOURCE_REVISION="${PACS_AI_SOURCE_REVISION}"

LABEL org.opencontainers.image.title="DeepCORO-SYNTAX" \
      org.opencontainers.image.version="${PACS_AI_MODEL_VERSION}-local" \
      org.opencontainers.image.revision="${PACS_AI_SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/${PACS_AI_SOURCE_REPOSITORY}" \
      ai.heartwise.model.repository="${PACS_AI_MODEL_REPOSITORY}" \
      ai.heartwise.model.revision="${PACS_AI_MODEL_REVISION}" \
      ai.heartwise.model.weights.path="${PACS_AI_WEIGHTS_PATH}" \
      ai.heartwise.model.weights.sha256="${PACS_AI_WEIGHTS_SHA256}" \
      ai.heartwise.release.channel="local"

EXPOSE 8000

ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

# Development build from the NAS copy, without Hugging Face. Copy the encoder and the probes into
# models/ first (the layout of the Hugging Face repository), then build:
#
#   R=/mnt/data1/models/DeepECG-PNG/acs_ft20_dinov3_siglip2_epoch030
#   (cd $R/probes && sha256sum -c SHA256SUMS)
#   mkdir -p models/base && cp $R/base/epoch_030.pt models/base/ && cp -r $R/probes models/
#   docker build --platform linux/amd64 -f Dockerfile.local -t pacs-ai-deepecg-clip-dinov3:local .
#
# The build fails unless the encoder and every probes/SHA256SUMS file match. The image carries the
# "local" release-channel label and must not be published.
FROM python:3.12.1-slim

ARG PACS_AI_SOURCE_REPOSITORY="HeartWise-AI/pacs-ai-backend"
ARG PACS_AI_SOURCE_REVISION=""
ARG PACS_AI_MODEL_VERSION="1.1.0"
ARG PACS_AI_MODEL_REPOSITORY="heartwise/DeepECG-PNG_DINOv3-SigLIP2_epoch030"
ARG PACS_AI_MODEL_REVISION="3eab18b498f1b05f7749052fd40d00980b4c16d1"
ARG PACS_AI_WEIGHTS_PATH="base/epoch_030.pt"
ARG PACS_AI_WEIGHTS_SHA256="335aaec39064d009c31710a96fe17d98450d85611c5bb0271ce3aad118149ae6"

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uv

WORKDIR /app

COPY requirements.txt .
RUN uv pip install -r requirements.txt --system

COPY models/ ./models/
COPY download_model.py .
RUN python download_model.py \
      --verify-only \
      --repository "${PACS_AI_MODEL_REPOSITORY}" \
      --revision "${PACS_AI_MODEL_REVISION}" \
      --weights-path "${PACS_AI_WEIGHTS_PATH}" \
      --weights-sha256 "${PACS_AI_WEIGHTS_SHA256}"

COPY main.py .
COPY logic.py .
COPY report_input.py .
COPY config.json .
COPY data/ ./data/
COPY docs/ ./docs/
COPY utils/ ./utils/
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

ENV PACS_AI_SOURCE_REVISION="${PACS_AI_SOURCE_REVISION}"
ENV PACS_AI_MODEL_VERSION="${PACS_AI_MODEL_VERSION}"
ENV HF_HUB_OFFLINE=1

LABEL org.opencontainers.image.title="DeepECG-CLIP-DINOv3" \
      org.opencontainers.image.version="${PACS_AI_MODEL_VERSION}-local" \
      org.opencontainers.image.revision="${PACS_AI_SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/${PACS_AI_SOURCE_REPOSITORY}" \
      ai.heartwise.model.repository="${PACS_AI_MODEL_REPOSITORY}" \
      ai.heartwise.model.revision="${PACS_AI_MODEL_REVISION}" \
      ai.heartwise.model.weights.path="${PACS_AI_WEIGHTS_PATH}" \
      ai.heartwise.model.weights.sha256="${PACS_AI_WEIGHTS_SHA256}" \
      ai.heartwise.release.channel="local"

EXPOSE 8000

ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

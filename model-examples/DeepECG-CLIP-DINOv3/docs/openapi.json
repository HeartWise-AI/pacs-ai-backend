{
  "openapi": "3.0.2",
  "info": {
    "title": "DeepECG-CLIP-DINOv3 Inference API",
    "description": "Research-only 12-lead ECG model (DINOv3 ViT-B/16, DeepECG-CLIP pretraining): acute coronary occlusion and complete vs incomplete occlusion, plus any frozen linear-probe heads shipped with the weights. One ECG per request; every head is returned unless additionalMetadata.heads names a subset. Not for clinical use.",
    "termsOfService": "https://github.com/HeartWise-AI",
    "contact": {
      "name": "HeartWise AI",
      "email": "hello@heartwise.ai"
    },
    "version": "1.5.1"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Container reverse proxy"
    },
    {
      "url": "http://localhost:8000",
      "description": "Direct local API"
    }
  ],
  "tags": [
    {
      "name": "Inference",
      "description": "Inference service"
    }
  ],
  "paths": {
    "/inference/predict": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Predict",
        "description": "Creates a prediction request",
        "requestBody": {
          "description": "Prediction request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PredictResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/inference/render-report": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Render report",
        "description": "HTML report of a stored JSON-mode result, the same document HTML-mode predict returns for that prediction. CPU only: no model load, no forward pass, no GPU; does not count as model activity. Nothing stored is copied into the page: the numbers are checked and the report is rendered from them, and a result whose values or text are not what this model version writes for those numbers is refused. Body at most 64 KB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderReportRequest"
              },
              "example": {
                "result": {
                  "diagnosis": "DeepECG-CLIP-DINOv3: occlusion suspected (ACO probability 0.421, threshold 0.0506); input: waveform | research use only, not a clinical diagnosis",
                  "predictions": {
                    "heads": [
                      {
                        "id": "aco",
                        "head": "aco",
                        "label": "Acute coronary occlusion (ACO)",
                        "description": "Acute coronary occlusion (complete or incomplete) vs no occlusion on the catheterization that followed the ECG (ACS cohort v6). Fine-tuned DINOv3, top 2 blocks.",
                        "task": "binary",
                        "kind": "fine-tuned",
                        "probability": 0.4213,
                        "threshold": 0.05062838,
                        "positive": true,
                        "applicable": true,
                        "applicableWhen": null
                      }
                    ],
                    "input": {
                      "source": "waveform",
                      "description": "DICOM 12-lead waveform, drawn with the training renderer"
                    },
                    "notes": "Probabilities are model outputs, not calibrated risks. Each threshold is the Youden point of its validation set; an output without a threshold gives a probability only (positive is null). An output with applicableWhen is only interpreted when that output is positive."
                  },
                  "modelRecommendations": {
                    "en": "<strong>Acute coronary occlusion suspected (probability 0.421).</strong> The model output is above the research threshold. Correlate with symptoms, serial ECGs and troponin. Research use only: do not change management on the basis of this output.",
                    "fr": "<strong>Occlusion coronarienne aiguë suspectée (probabilité 0.421).</strong> La sortie du modèle dépasse le seuil de recherche. Corréler avec les symptômes, les ECG sériés et la troponine. Usage en recherche seulement : ne pas modifier la prise en charge sur la base de ce résultat.",
                    "presentable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report rendered",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/RenderReportResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 64 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Body larger than 65536 bytes",
                  "data": {},
                  "errorCode": "PAYLOAD_TOO_LARGE"
                }
              }
            }
          },
          "422": {
            "description": "Body is not JSON, or the result is not a JSON-mode result of this model version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Cannot render this result: diagnosis: is not what this model writes for these predictions",
                  "data": {},
                  "errorCode": "INVALID_RESULT"
                }
              }
            }
          }
        }
      }
    },

{
  "openapi": "3.0.2",
  "info": {
    "title": "DeepECG-CLIP-DINOv3 Inference API",
    "description": "Research-only 12-lead ECG model: frozen linear-probe heads on the DINOv3-SigLIP2 ECG image encoder (77 ECG findings, SHD, LVEF <= 40%, LVEF < 50%, incident AFib at 5 years, HCM, acute coronary occlusion). One ECG per request; every enabled head is returned unless additionalMetadata.heads names a subset. Not for clinical use.",
    "termsOfService": "https://github.com/HeartWise-AI",
    "contact": {
      "name": "HeartWise AI",
      "email": "hello@heartwise.ai"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Container reverse proxy"
    },
    {
      "url": "http://localhost:8000",
      "description": "Direct local API"
    }
  ],
  "tags": [
    {
      "name": "Inference",
      "description": "Inference service"
    }
  ],
  "paths": {
    "/inference/predict": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Predict",
        "description": "Creates a prediction request",
        "requestBody": {
          "description": "Prediction request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "4xx": {
            "description": "Client side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "5xx": {
            "description": "Server side errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PredictResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/inference/render-report": {
      "post": {
        "tags": [
          "Inference"
        ],
        "summary": "Render report",
        "description": "HTML report of a stored JSON-mode result, the same document HTML-mode predict returns for that prediction. CPU only: no model load, no forward pass, no GPU; does not count as model activity. Nothing stored is copied into the page: the numbers are checked and the report is rendered from them, and a result whose values or text are not what this model version writes for those numbers is refused. Body at most 64 KB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderReportRequest"
              },
              "example": {
                "result": {
                  "diagnosis": "DeepECG-CLIP-DINOv3: occlusion suspected (ACO probability 0.421, threshold 0.0470); other positive outputs: SHD (structural heart disease, EchoNext definition) (0.612) of 3; input: waveform | research use only, not a clinical diagnosis",
                  "predictions": {
                    "heads": [
                      {
                        "id": "shd",
                        "label": "SHD (structural heart disease, EchoNext definition)",
                        "probability": 0.6123,
                        "threshold": 0.537370502948761,
                        "positive": true,
                        "applicable": true
                      },
                      {
                        "id": "lvef_le40",
                        "label": "LVEF <= 40% (round(EF,3) <= 40)",
                        "probability": 0.0812,
                        "threshold": 0.16951389610767365,
                        "positive": false,
                        "applicable": true
                      },
                      {
                        "id": "hcm",
                        "label": "HCM",
                        "probability": 0.0011,
                        "threshold": 0.0027414804009191847,
                        "positive": false,
                        "applicable": true
                      },
                      {
                        "id": "aco",
                        "label": "ACO",
                        "probability": 0.4213,
                        "threshold": 0.046955234134749495,
                        "positive": true,
                        "applicable": true
                      },
                      {
                        "id": "ecg77:Sinusal",
                        "label": "Sinusal",
                        "probability": 0.9821,
                        "threshold": null,
                        "positive": null,
                        "applicable": true
                      },
                      {
                        "id": "ecg77:Afib",
                        "label": "Afib",
                        "probability": 0.0103,
                        "threshold": null,
                        "positive": null,
                        "applicable": true
                      },
                      {
                        "id": "ecg77:Left bundle branch block",
                        "label": "Left bundle branch block",
                        "probability": 0.0042,
                        "threshold": null,
                        "positive": null,
                        "applicable": true
                      }
                    ],
                    "input": {
                      "source": "waveform",
                      "description": "DICOM 12-lead waveform, drawn with the training renderer"
                    },
                    "model": {
                      "encoder": "DINOv3-SigLIP2 zo59vdxk epoch 30",
                      "probes": "clean"
                    },
                    "notes": "Research use only: probabilities are model outputs (frozen linear probes on the DINOv3-SigLIP2 ECG encoder), not calibrated risks, with no external validation. A flag (positive) is given only where a validation Youden threshold exists; the 77 ECG findings are probabilities only."
                  },
                  "modelRecommendations": {
                    "en": "<strong>Acute coronary occlusion suspected (probability 0.421).</strong> The model output is above the research threshold. Correlate with symptoms, serial ECGs and troponin. Research use only: do not change management on the basis of this output.",
                    "fr": "<strong>Occlusion coronarienne aiguë suspectée (probabilité 0.421).</strong> La sortie du modèle dépasse le seuil de recherche. Corréler avec les symptômes, les ECG sériés et la troponine. Usage en recherche seulement : ne pas modifier la prise en charge sur la base de ce résultat.",
                    "presentable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report rendered",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/RenderReportResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 64 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Body larger than 65536 bytes",
                  "data": {},
                  "errorCode": "PAYLOAD_TOO_LARGE"
                }
              }
            }
          },
          "422": {
            "description": "Body is not JSON, or the result is not a JSON-mode result of this model version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "Cannot render this result: diagnosis: is not what this model writes for these predictions",
                  "data": {},
                  "errorCode": "INVALID_RESULT"
                }
              }
            }
          }
        }
      }
    },

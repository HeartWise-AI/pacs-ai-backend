      }
    },
    "/inference/model-facts": {
      "get": {
        "tags": [
          "Inference"
        ],
        "summary": "Get Model Facts",
        "description": "Get model facts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetModelFactsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "message": "Model facts retrieved successfully",
                  "data": {
                    "en": {
                      "Summary": {
                        "Name": "DeepECG-CLIP-DINOv3",
                        "Description": "Research ECG model: frozen linear-probe heads on the DINOv3-SigLIP2 ECG image encoder (DeepECG-PNG, zo59vdxk, epoch 30), one encoder pass per ECG. Outputs: 77 ECG findings (probabilities), structural heart disease, LVEF <= 40%, LVEF < 50%, incident AFib at 5 years, HCM and acute coronary occlusion.",

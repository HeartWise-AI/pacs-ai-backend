  "components": {
    "schemas": {
      "PredictRequest": {
        "required": [
          "outputMode"
        ],
        "type": "object",
        "properties": {
          "seriesInstanceMetadata": {
            "type": "object"
          },
          "additionalMetadata": {
            "type": "object",
            "nullable": true,
            "description": "Optional. {\"heads\": [names]} returns only these outputs: output ids (\"aco\", \"ecg77:Afib\") or head names (\"ecg77\" selects its 77 outputs). Disabled heads are refused. Omitted: every enabled output."
          },
          "outputMode": {
            "type": "string",
            "enum": [
              "HTML",
              "JSON"
            ],
            "description": "Output mode"
          },
          "seriesInstanceImages": {
            "type": "object",
            "nullable": true,
            "description": "Series and instance indices mapped to base64-encoded DICOM files of one ECG study: 12-lead/general ECG waveform (preferred), Encapsulated PDF with a vector ECG, or a single-frame ECG image.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "APIResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation successful"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "APIErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Bad Request"
          },
          "errorCode": {
            "type": "string",
            "example": "BAD_REQUEST"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "GetModelInfoResponse": {
        "type": "object",
        "properties": {
          "modelName": {
            "type": "string",
            "description": "Model display name",
            "example": "DeepECG-CLIP-DINOv3"
          },
          "version": {
            "type": "string",
            "description": "Model version",
            "example": "1.0.1"
          },
          "dicomTargetLevel": {
            "type": "string",
            "enum": [
              "PATIENT",
              "STUDY",
              "SERIES",
              "INSTANCE"
            ],
            "description": "DICOM target level",
            "example": "STUDY"
          },
          "dicomUploadMin": {
            "type": "integer",
            "description": "Minimum number of DICOM instances to upload for inference",
            "example": 1
          },
          "dicomUploadMax": {
            "type": "integer",
            "description": "Maximum number of DICOM instances to upload for inference",
            "example": 10
          },
          "supportedDicomModalities": {
            "type": "array",
            "description": "Supported DICOM modalities",
            "items": {
              "type": "string",
              "example": "ECG"
            },
            "example": [
              "ECG"
            ]
          },
          "supportedDicomTags": {
            "type": "array",
            "description": "Supported DICOM tags",
            "items": {
              "type": "string",
              "example": "00200011"
            },
            "example": [
              "*"
            ]
          },
          "supportedAdditionalMetadata": {
            "type": "array",
            "description": "Supported additional metadata",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "smoking"
                },
                "name": {
                  "type": "string",
                  "example": "Smoking"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "boolean",
                    "number",
                    "string"
                  ],
                  "example": "boolean"
                },
                "required": {
                  "type": "boolean",
                  "example": true
                }
              }
            },
            "example": []
          },
          "supportedOutputModes": {
            "type": "array",
            "description": "Supported output modes",
            "items": {
              "type": "string",
              "enum": [
                "HTML",
                "JSON"
              ],
              "example": "JSON"
            },
            "example": [
              "HTML",
              "JSON"
            ]
          }
        }
      },
      "GetModelFactsResponse": {
        "type": "object",
        "properties": {
          "en": {
            "type": "object",
            "description": "Model facts in English. See example for more details."
          }
        }
      },
      "PredictResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "htmlBase64"
            ],
            "properties": {
              "htmlBase64": {
                "type": "string",
                "description": "Base64-encoded DeepECG-CLIP-DINOv3 HTML research report."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "predictions",
              "modelRecommendations"
            ],
            "properties": {
              "predictions": {
                "type": "object",
                "description": "predictions.heads: one entry per output (id, label, probability, threshold, positive, applicable); predictions.input: which DICOM object was read; predictions.model: encoder and probe version; predictions.input: which DICOM object was read."
              },
              "diagnosis": {
                "type": "string",
                "nullable": true
              },
              "modelRecommendations": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "en": {
                    "type": "string",
                    "nullable": true
                  },
                  "fr": {
                    "type": "string",
                    "nullable": true
                  },
                  "presentable": {
                    "type": "boolean",
                    "nullable": true
                  }
                }
              }
            }
          }
        ]
      },
      "ModelRuntime": {
        "type": "object",
        "required": [
          "state",
          "loaded",
          "activeRequests",
          "lastUsedAt"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "UNLOADED",
              "LOADING",
              "READY",
              "BUSY",
              "EVICTING",
              "ERROR"
            ]
          },
          "loaded": {
            "type": "boolean"
          },
          "activeRequests": {
            "type": "integer",
            "minimum": 0
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "error": {
            "type": "string"
          }
        }
      },
      "RenderReportRequest": {
        "type": "object",
        "required": [
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "object",
            "description": "The data object of a JSON-mode predict response ({diagnosis, predictions, modelRecommendations}) as stored by the caller; the whole response envelope is accepted too. The stored no-ECG answer (predictions {}) renders the no-ECG page."
          }
        }
      },
      "RenderReportResponse": {
        "type": "object",
        "properties": {
          "htmlBase64": {
            "type": "string",
            "description": "Base64-encoded HTML report, identical to HTML-mode predict for the same prediction"
          },
          "modelVersion": {
            "type": "string",
            "description": "Container version that rendered the report",
            "example": "1.0.1"
          }
        }
      }
    }
  }
}

                        "Pinned_revision": "7d35c2e75b8013097c9bb4a578750434e9e10be2 (tag v1.3.0)",
                        "Checkpoints": "aco/best_model.pth (sha256 49db22c3...9026); pretraining base/epoch_030.pt used only by frozen probes",
                        "Training": "DeepECG-PNG commit 1f6fb84 (PR #224); pretraining W&B mhi_ai run zo59vdxk epoch 30; fine-tunes W&B project deepecg_dinov3_siglip2_finetune"
                      }

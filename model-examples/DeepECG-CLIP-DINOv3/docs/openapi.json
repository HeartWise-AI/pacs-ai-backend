            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/APIResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetModelFactsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "success": true,
                  "message": "Model facts retrieved successfully",
                  "data": {
                    "en": {
                      "Summary": {
                        "Name": "DeepECG-CLIP-DINOv3",
                        "Description": "Research ECG model from one 12-lead ECG: acute coronary occlusion (ACO), from a DINOv3 ViT-B/16 encoder pretrained contrastively on MHI ECG images and reports, plus frozen linear-probe heads on the same encoder (77 ECG patterns, SHD, LVEF, AFib 5 y, HCM).",
                        "Developed_by": "HeartWise.AI / Montreal Heart Institute",
                        "Version": "1.5.1"
                      },
                      "Mechanism": {
                        "Outcome": "aco: acute coronary occlusion on the catheterization following the ECG (ACS cohort v6).",
                        "Output": "One entry per head: probability (sigmoid), validation Youden threshold, positive flag. Every available head is returned by default; additionalMetadata.heads selects a subset.",
                        "Target_population": "Adults with a 12-lead resting ECG in the MHI acute coronary syndrome cohort (development population).",
                        "Input_data_source": "One ECG per request, chosen from the study: DICOM 12-lead or general ECG waveform first, then an Encapsulated PDF holding a vector ECG (standard 3x4 + lead II rhythm layout), then a single-frame ECG image; earliest acquisition first.",
                        "Input_data_type": "dicom",
                        "Model_type": "Deep learning: DINOv3 ViT-B/16 (448x896 grayscale page, ImageNet normalisation); the fine-tuned head runs the frozen first 10 blocks, then its own top 2 blocks and linear head.",
                        "Supported_DICOM_modalities": "ECG (waveform), DOC (Encapsulated PDF), OT (secondary capture)"
                      },
                      "Performance": {
                        "Test_set": "MHI ACS v6 held-out test split: 9,021 ECGs of 4,371 patients, 589 occlusions.",
                        "aco": "AUROC 0.92 (95% CI 0.89-0.93), AUPRC 0.64, sensitivity 0.83, specificity 0.87, PPV 0.31, NPV 0.99 at threshold 0.0506 (clean renders); AUROC 0.90 on augmented renders.",
                        "Smartphone_photos": "300 photographs of test ECGs: any occlusion AUROC 0.89 (photo) vs 0.91 (native)."
                      },
                      "Uses_and_directions": {
                        "General_use": "Research on ECG-based detection of acute coronary occlusion.",
                        "Directions": "Send the ECG study (waveform preferred). Read each output as a model score against its threshold.",
                        "Not_intended_use": "Diagnosis, triage or catheterization decisions; ruling out an acute coronary syndrome."
                      },
                      "Warnings_and_limitations": {
                        "Research_only": "No regulatory clearance, no calibration analysis, no external validation.",
                        "Input_fidelity": "Waveforms sampled at a multiple of 250 Hz give the training pixels exactly (training renderer, MUSE-era style); about 30% of training pages came from a later render style, on which outputs differ slightly. PDFs are redrawn from their vector traces (close, not identical). Images are used as they are and were only seen through training augmentation.",
                        "Pretraining_overlap": "311 of 4,371 test patients have another ECG in the encoder's pretraining corpus; without them the aco AUROC is 0.90.",
                        "Thresholds": "Youden points on the augmented validation split; no clinical operating point chosen.",
                        "License": "Weights derive from Meta DINOv3 and are subject to the DINOv3 license."

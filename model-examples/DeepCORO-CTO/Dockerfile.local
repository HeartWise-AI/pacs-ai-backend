# Build without HuggingFace download — expects the .pt checkpoint to already
# sit in ./models/ on the build host. Use this when you have the weights
# locally (the J-CTO run: pdnzpnpy_20260702-222016/models/best_model_epoch_24.pt).
#
#   cp <run_dir>/models/best_model_epoch_24.pt models/
#   docker build -f Dockerfile.local -t heartwisehub/deepcoro-cto:1.0 .
FROM python:3.12.1-slim

RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor git

RUN pip install uv

WORKDIR /app

COPY requirements.txt .
RUN uv pip install -r requirements.txt --system

COPY main.py .
COPY logic.py .
COPY config.json .
COPY data/ ./data/
COPY docs/ ./docs/
COPY models/ ./models/
COPY utils/ ./utils/
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisord.conf

EXPOSE 8000

ENTRYPOINT []
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]

  },
  "components": {
    "schemas": {
      "PredictRequest": {
        "required": [
          "outputMode"
        ],
        "type": "object",
        "properties": {
          "seriesInstanceImages": {
            "type": "object",
            "description": "Map of series number -> instance number -> base64-encoded XA DICOM. Up to 12 runs are used, chosen by SeriesTime.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "seriesInstanceMetadata": {
            "type": "object",
            "nullable": true
          },
          "additionalMetadata": {
            "type": "object",
            "nullable": true,
            "description": "Unused for DeepCORO-JEPA."
          },
          "outputMode": {
            "type": "string",
            "enum": [
              "HTML",
              "JSON"
            ],
            "description": "Output mode supported by DeepCORO-JEPA"
          }
        }
      },
      "APIResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation successful"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "APIErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Bad Request"
          },
          "errorCode": {
            "type": "string",
            "example": "BAD_REQUEST"
          },
          "data": {
            "type": "object",
            "example": {}
          }
        }
      },
      "GetModelInfoResponse": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string",
            "description": "Model identifier",
            "example": "DeepCORO_JEPA"
          },
          "modelName": {
            "type": "string",
            "description": "Model display name",
            "example": "DeepCORO-JEPA"
          },
          "version": {
            "type": "string",
            "description": "Model version",
            "example": "1.0.0"
          },
          "dicomTargetLevel": {
            "type": "string",
            "enum": [
              "PATIENT",
              "STUDY",
              "SERIES",
              "INSTANCE"
            ],
            "description": "DICOM target level",
            "example": "SERIES"
          },
          "dicomUploadMin": {
            "type": "integer",
            "description": "Minimum number of DICOM videos to upload for inference",
            "example": 1
          },
          "dicomUploadMax": {
            "type": "integer",
            "description": "Maximum number of DICOM videos used per study",
            "example": 8
          },
          "supportedDicomModalities": {
            "type": "array",
            "description": "Supported DICOM modalities",
            "items": {
              "type": "string",
              "example": "XA"
            }
          },
          "supportedDicomTags": {
            "type": "array",
            "description": "Supported DICOM tags",
            "items": {
              "type": "string",
              "example": "*"
            }
          },
          "supportedAdditionalMetadata": {
            "type": "array",
            "description": "No Step-2 variables; view class is inferred from positioner angles",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "supportedOutputModes": {
            "type": "array",
            "description": "Supported output modes",
            "items": {
              "type": "string",
              "enum": [
                "JSON",
                "HTML"
              ],
              "example": "JSON"
            }
          }
        }
      },
      "GetModelFactsResponse": {
        "type": "object",
        "properties": {
          "en": {
            "type": "object",
            "description": "Model facts in English. See the example for the outputs, thresholds and limits of DeepCORO-JEPA."
          }
        }
      },
      "PredictResponse": {
        "type": "object",
        "description": "JSON mode returns diagnosis/predictions/modelRecommendations; HTML mode returns htmlBase64.",
        "properties": {
          "diagnosis": {
            "type": "string",
            "description": "Short summary of the flagged segments and the LAD FFR/iFR calls (JSON mode)"
          },
          "predictions": {
            "type": "object",
            "description": "segments.<segment> with stenosis_pct, prob_significant, prob_threshold, significant, significant_threshold_pct; lad_physiology with ffr, ifr, ffr_abnormal_prob, ifr_abnormal_prob, their thresholds and yes/no calls, operating_point; n_videos; encoder_passes"
          },
          "modelRecommendations": {
            "type": "object",
            "description": "Operator-facing EN/FR recommendations (JSON mode)"
          },
          "htmlBase64": {
            "type": "string",
            "description": "Base64-encoded HTML report (HTML mode)"
          }
        }
      },
      "ModelRuntime": {
        "type": "object",
        "required": [
          "state",
          "loaded",
          "activeRequests",
          "lastUsedAt"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "UNLOADED",
              "LOADING",
              "READY",
              "BUSY",
              "EVICTING",
              "ERROR"
            ]
          },
          "loaded": {
            "type": "boolean"
          },
          "activeRequests": {
            "type": "integer",
            "minimum": 0
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}

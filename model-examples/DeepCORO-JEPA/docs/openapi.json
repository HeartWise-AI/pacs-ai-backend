{
  "openapi": "3.0.2",
  "info": {
    "title": "DeepCORO-JEPA inference API",
    "description": "PACS.AI inference API for DeepCORO-JEPA, a research-preview model that reads 18-segment coronary stenosis and LAD FFR/iFR from diagnostic coronary angiography (XA), with a yes/no call per output at a validation-derived threshold.",
    "termsOfService": "https://github.com/HeartWise-AI",
    "contact": {
      "name": "HeartWise AI",
      "email": "hello@heartwise.ai"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://deepcoro-jepa/api",
      "description": "Docker"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local"
    },
    {
      "url": "http://localhost:8000/api",
      "description": "Local Docker"
    }
  ],
  "tags": [
    {
      "name": "Inference",
      "description": "Inference service"
    }
  ],
  "paths": {

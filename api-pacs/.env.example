# Service identity and public URL used in emails/links. Keep API_NAME and
# API_URL_REST_PORT as shown unless you also change compose/nginx wiring.
API_NAME=api-pacs
API_URL_REST_PORT=8000
APP_URL=

# HTTP request safety. Values are bytes unless the variable name says seconds.
API_MAX_REQUEST_BODY_BYTES=16777216
INFERENCE_PREDICT_MAX_REQUEST_BODY_BYTES=1048576
# Authenticated large-clinical-upload exception; keep consistent with
# NGINX_DICOMWEB_MAX_BODY_SIZE in nginx/.env (6g by default).
DICOMWEB_MAX_REQUEST_BODY_BYTES=6442450944
# Maximum total time for api-pacs to read an authenticated DICOMweb request.
# This protects direct access to api-pacs when Nginx is bypassed.
DICOMWEB_READ_TIMEOUT_SECONDS=7200
HTTP_SERVER_READ_HEADER_TIMEOUT_SECONDS=10
HTTP_SERVER_READ_TIMEOUT_SECONDS=30
HTTP_SERVER_IDLE_TIMEOUT_SECONDS=120

# Direct inference input bounds. Model-specific dicomUploadMin/dicomUploadMax
# are also enforced and may be stricter than these hard safety ceilings.
INFERENCE_MAX_SERIES_UIDS=256
INFERENCE_MAX_METADATA_BYTES=65536
INFERENCE_MAX_METADATA_DEPTH=8
INFERENCE_MAX_METADATA_ENTRIES=256

# Orchestrator chat and DICOM-selection bounds.
ORCHESTRATOR_MAX_REQUEST_BODY_BYTES=8388608
ORCHESTRATOR_MAX_STUDIES_PER_REQUEST=20
ORCHESTRATOR_MAX_SERIES_UIDS_PER_STUDY=256
ORCHESTRATOR_MAX_PREVIEW_BASE64_BYTES=2097152
ORCHESTRATOR_MAX_METADATA_BYTES=65536
ORCHESTRATOR_MAX_METADATA_DEPTH=8
ORCHESTRATOR_MAX_METADATA_ENTRIES=256
ORCHESTRATOR_MAX_MESSAGE_BYTES=32768

# Ingestion loop timing in minutes. Missing or invalid values default to these.
INFERENCE_INGESTION_RUNNER_INTERVAL_MINUTES=1
INFERENCE_INGESTION_RETRIEVAL_WORKER_INTERVAL_MINUTES=1
# C-FIND lookback window for recent studies when discovering work.
INFERENCE_INGESTION_DEFAULT_RECENT_WINDOW_MINUTES=240

# Required when public registration or adaptive login protection is enabled.
CLOUDFLARE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_BASE_URL=https://challenges.cloudflare.com/turnstile/v0
# Public registration attempts per fixed window. Missing or invalid values use
# these safe defaults.
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=600
REGISTRATION_RATE_LIMIT_TENANT_ATTEMPTS=100
REGISTRATION_RATE_LIMIT_EMAIL_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_IP_ATTEMPTS=10
# Comma-separated CIDRs of direct reverse proxies allowed to set X-Real-IP.
# Leave empty when api-pacs is reached directly. For Docker, use the exact
# pacs-net subnet reported by `docker network inspect pacs-net`.
REGISTRATION_TRUSTED_PROXY_CIDRS=

# Current public-demo legal documents. Publish these exact versions at the
# canonical HTTPS URLs before enabling a production public registration flow.
POLICY_TERMS_VERSION=2026-08-15
POLICY_TERMS_URL=https://pacsai.co/terms-of-service
POLICY_TERMS_EFFECTIVE_AT=2026-08-15
POLICY_PRIVACY_VERSION=2026-08-15
POLICY_PRIVACY_URL=https://pacsai.co/privacy-policy
POLICY_PRIVACY_EFFECTIVE_AT=2026-08-15
# Optional RFC3339 cutoff for existing users. Empty means immediate enforcement.
# Registration always requires current policy acceptance even during this grace.
POLICY_EXISTING_USER_GRACE_UNTIL=

# Server-owned adaptive login protection. Successful low-risk logins are not
# challenged. Disabling protection is an emergency-only control and emits a
# security warning; Firebase password authentication still remains backend-owned.
FIREBASE_WEB_API_KEY=
LOGIN_ABUSE_PROTECTION_ENABLED=true
LOGIN_FAILURE_WINDOW_SECONDS=600
LOGIN_ACCOUNT_CHALLENGE_FAILURES=3
LOGIN_IP_CHALLENGE_FAILURES=5
LOGIN_IP_MAX_FAILURES=30
LOGIN_TENANT_CHALLENGE_FAILURES=50
LOGIN_TENANT_MAX_FAILURES=500
# Hostnames returned by Turnstile Siteverify for the login widget. Use exact
# deployment hostnames without scheme, port, or path. Production should not
# include localhost or 127.0.0.1.
LOGIN_TURNSTILE_ALLOWED_HOSTNAMES=
# Comma-separated direct-proxy CIDRs allowed to supply X-Real-IP for login.
LOGIN_TRUSTED_PROXY_CIDRS=

# Per-tenant, per-user inference allowance. One direct prediction or one
# manual reprocessing run consumes one unit. Active reservations expire as a
# recovery safeguard if a worker never reports a terminal state.
INFERENCE_USER_QUOTA_WINDOW_SECONDS=86400
INFERENCE_USER_QUOTA_ALLOWANCE=50
INFERENCE_USER_MAX_CONCURRENT_EXECUTIONS=2
INFERENCE_USER_RESERVATION_TTL_SECONDS=7200
# Optional JSON object keyed by tenant ID. Any omitted field inherits the
# defaults above. Example:
# {"tenant-id":{"allowance":100,"maxConcurrentExecutions":4}}
INFERENCE_USER_QUOTA_TENANT_OVERRIDES_JSON=

# Registry login for pulling private inference images. Optional when images
# are public. These are registry credentials, not the Docker daemon socket
# (compose mounts /var/run/docker.sock read-only separately).
DOCKER_USERNAME=
DOCKER_PASSWORD=
# External Docker network attached to inference containers. Must already
# exist and match compose (`docker network create pacs-net` by default).
DOCKER_NETWORK=pacs-net

# Optional DocuSign JWT auth for e-signature flows. Leave empty when unused.
# DOCUSIGN_PRIVATE_KEY is the RSA private key (PEM); quote multi-line values.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_BASE_URI=
DOCUSIGN_AUTH_SERVER=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_ACCOUNT_ID=

# Elasticsearch HTTP URL for study/log search. Compose default:
# http://elasticsearch:9200
ELASTICSEARCH_URL=

# Firebase Admin SDK. Mount the service-account JSON into the container and
# point FIREBASE_CONFIG_FILE_PATH at that path. SUPERUSER_KEY gates first-user
# bootstrap and privileged admin API access; use a strong secret.
FIREBASE_CONFIG_FILE_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_SUPERUSER_KEY=

# Kibana base URL for log deep-links. Compose default: http://kibana:5601
KIBANA_BASE_URL=

# Optional Mailchimp marketing list sync.
MAILCHIMP_API_KEY=
MAILCHIMP_BASE_URL=
MAILCHIMP_LIST_ID=

# Transactional email via Mailgun (password resets, invites, notifications).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER_EMAIL=

# Basic-auth password for the OpenAPI /docs UI. Leave empty to disable docs auth.
OPENAPI_DOCS_PASSWORD=

# Orthanc PACS connection. AET must be unique on your DICOM network.
ORTHANC_AET=PACS_AI
ORTHANC_BASE_URL=http://orthanc:8042
ORTHANC_LOCAL_CACHE_EXPIRATION_IN_HOURS=24

# Internal service URLs on pacs-net. study-service tokens must match the
# values configured in cardio-agent/study-service.
ORCHESTRATOR_API_URL=http://medical-agent:8585
API_BASE_URL=http://api-pacs:8000/v1
STUDY_SERVICE_BASE_URL=http://study-service:8600
STUDY_SERVICE_INGEST_TOKEN=
STUDY_SERVICE_CALLBACK_TOKEN=
STUDY_SERVICE_OPERATOR_TOKEN=
# Strict processing-run correlation is the post-rollout default. Set this to
# false only during a controlled compatibility or rollback window.
INFERENCE_REQUIRE_PROCESSING_RUN_ID=true

# PostgreSQL control-plane database. Host is typically `postgresql` on pacs-net.
POSTGRES_DB_HOST=
POSTGRES_DB_PORT=5432
POSTGRES_DB_DATABASE=
POSTGRES_DB_USERNAME=
POSTGRES_DB_PASSWORD=

# Redis for IAM cache and rate-limit counters. Password must match redis.conf
# (and cardio-agent REDIS_URL when integrated). REDIS_IAM_DB is the IAM index.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_IAM_DB=1
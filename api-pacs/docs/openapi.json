    "/ecs/logs": {
      "get": {
        "tags": ["elasticsearch"],
        "summary": "Search Elasticsearch Logs",
        "description": "Search elasticsearch logs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "description": "Index of document",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "logins",
                "admin_members",
                "find_modality_studies",
                "retrieved_studies"
              ]
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "Target query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Start date range (YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "End date range (YYYY-MM-DD)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "export",
            "in": "query",
            "description": "Export to CSV",
            "required": false,
            "schema": {
              "type": "boolean",
              "nullable": true
            }
          }
        ],
        "responses": {
          "2xx": {
            "description": "Success"
          },
          "4xx": {
            "description": "Client side errors"
          },
          "5xx": {
            "description": "Server side errors"
          }
        }
      }
    },

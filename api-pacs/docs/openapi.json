            "type": "string"
          },
          "patientID": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          },
          "patientSex": {
            "type": "string"
          },
          "referringPhysicianName": {
            "type": "string"
          },
          "requestingPhysician": {
            "type": "string"
          },
          "studyDate": {
            "type": "string"
          },
          "studyDescription": {
            "type": "string"
          },
          "studyID": {
            "type": "string"
          },
          "studyInstanceUID": {
            "type": "string"
          },
          "studyTime": {
            "type": "string"
          }
        }
      },

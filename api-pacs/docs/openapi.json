        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string"
          },
          "idToken": {
            "type": "string"
          }
        }
      },
      "UpdateTenantUserRequest": {
        "required": ["id", "role", "name", "licenseNo", "specialty"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },

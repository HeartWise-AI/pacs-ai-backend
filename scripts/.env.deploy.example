# Configuration for scripts/deploy-model.sh
# Copy to scripts/.env.deploy and fill in. Keep .env.deploy out of git (chmod 600).

# --- Docker Hub ---
# Your Docker Hub username. Run `docker login` once locally before deploying.
# The backend pulls with its own DOCKER_USERNAME/DOCKER_PASSWORD env vars,
# so private repos work as long as those are set on the api-pacs container.
DOCKERHUB_USER=

# Image repos are named <DOCKERHUB_USER>/<IMAGE_PREFIX>-<modelname>:<version>
IMAGE_PREFIX=pacs-ai

# --- Backend API ---
# Base URL of the api-pacs service (e.g. http://localhost:8085 or https://pacs.example.com)
API_BASE_URL=

# Tenant + admin/owner account used to call the admin endpoints
TENANT_ID=
PACS_ADMIN_EMAIL=
PACS_ADMIN_PASSWORD=

# deploy-model.sh sends the admin email/password to the server-controlled
# /v1/iam/login endpoint. API_BASE_URL must therefore use HTTPS unless it is a
# loopback URL (localhost or 127.0.0.1).

# Optional single-use Cloudflare Turnstile token if adaptive login protection
# requires a challenge. Prefer setting this only for the invocation instead of
# persisting it here:
# PACS_LOGIN_TURNSTILE_TOKEN=<single-use-token> ./scripts/deploy-model.sh ...

# --- Optional ---
# Path to a file containing a HuggingFace token, used by models whose
# Dockerfile downloads weights via a BuildKit secret (DeepRV, DeepRV-CLIP,
# PanEcho, CathEF-CLIP, med_gemma_1.5, DeepCORO-CTO). Defaults to the repo
# root's hf_token.txt.
#HF_TOKEN_FILE=/path/to/hf_token.txt
# Output mode when registering a brand-new model (existing models keep theirs): JSON | OHIF_ANNOTATIONS | HTML | WEB_APP | PDF
#DEFAULT_OUTPUT_MODE=JSON

# Env vars passed to a brand-new model container, as a JSON array (existing models keep theirs)
#NEW_MODEL_ENVS=["SOME_KEY=value"]

# Seconds to wait for the new container to answer /inference/model-info (pull + start time)
#HEALTH_TIMEOUT_SECONDS=300

# Copy to scripts/.env.demo-xa, chmod 600, and fill in the blank values.
# Values containing # or spaces must be quoted.

# PACS-AI control-plane API and tenant administrator.
API_BASE_URL=https://pacs.example.com
TENANT_ID=
PACS_ADMIN_EMAIL=
PACS_ADMIN_PASSWORD=

# Source demo PACS queried by PACS-AI ingestion jobs. Rewritten studies are
# uploaded here so normal discovery can ingest them.
DEMO_XA_SOURCE_ORTHANC_URL=http://127.0.0.1:8063
DEMO_XA_SOURCE_ORTHANC_USER=
DEMO_XA_SOURCE_ORTHANC_PASSWORD=

# Website-facing PACS-AI Orthanc populated by retrieval. Every XA-only study in
# this Orthanc is snapshotted and replayed; no local seed directory is needed.
DEMO_XA_DESTINATION_ORTHANC_URL=http://127.0.0.1:8042
DEMO_XA_DESTINATION_ORTHANC_USER=
DEMO_XA_DESTINATION_ORTHANC_PASSWORD=

# Study-service operator API. Token may be blank only when local unauthenticated
# operator routes are enabled.
DEMO_XA_STUDY_SERVICE_URL=http://127.0.0.1:8600
STUDY_SERVICE_OPERATOR_TOKEN=

# Optional tuning.
APP_TIMEZONE=America/Toronto
DEMO_XA_WORK_DIR=.demo-xa-runs
DEMO_XA_POLL_SECONDS=10
DEMO_XA_DRAIN_TIMEOUT_SECONDS=300
DEMO_XA_STABLE_TIMEOUT_SECONDS=300
DEMO_XA_PROCESSING_TIMEOUT_SECONDS=3600
# DEMO_XA_COMPOSE_FILE=/absolute/path/to/pacs-ai-backend/docker-compose.yml
# DEMO_XA_PATIENT_ID_PREFIX=DEMO-XA
